name: appointment_cancellation_detector

# Environnement : l'image d'entraînement construite avec docker/Dockerfile
docker_env:
  image: legrosthierry/cancellation-train
  # Variables lues sur la machine qui lance `mlflow run`, transmises au conteneur
  environment: ["AWS_ACCESS_KEY_ID", "AWS_SECRET_ACCESS_KEY", "GIT_PYTHON_REFRESH"]

entry_points:
  main:
    parameters:
      n_estimators: {type: int, default: 100}
      min_samples_split: {type: int, default: 2}
    command: "python train.py --n_estimators {n_estimators} --min_samples_split {min_samples_split}"
